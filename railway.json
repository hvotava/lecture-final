{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "rootDirectory": "react-dashboard/frontend"
  },
  "deploy": {
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "variables": {
    "RAILPACK_NO_CACHE": "true",
    "RAILPACK_CACHE_DIR": "/tmp",
    "NODE_ENV": "production"
  },
  "version": "2025-08-20-00:05-rootdir-frontend"
} 